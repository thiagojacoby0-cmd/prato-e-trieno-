# GEMINI_API_KEY: Obrigatória para os recursos de IA (análise de refeições, cardápios, treinos e Personal IA).
# No Google AI Studio, já é gerenciada automaticamente via Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL onde o aplicativo está hospedado.
APP_URL="MY_APP_URL"

# SUPABASE (Banco PostgreSQL, Auth, Storage e Edge Functions)
# Todas as credenciais abaixo permanecem apenas no servidor (nunca expostas no frontend).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# VITE_API_BASE_URL: Opcional para build APK Android apontando para outro backend.
# VITE_API_BASE_URL="https://ais-pre-bdavefpacfd4ffbunhz7iu-799767735636.us-east1.run.app"

# PERSISTÊNCIA E BACKUPS AUTOMÁTICOS (SQLite, uploads e chave de sessão)
# DATA_DIR: Diretório persistente fora do build (padrão: ./data)
DATA_DIR="./data"
# BACKUP_KEEP_DAYS: Quantidade de dias para reter backups automáticos do banco (padrão: 14)
BACKUP_KEEP_DAYS="14"
